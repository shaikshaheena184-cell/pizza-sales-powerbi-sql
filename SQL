create table  pizza_sale(
order_id int primary key,
order_date date,
order_time time,
pizza_id varchar(10),
pizza_name varchar(100),
pizza_category varchar(40),
pizza_size varchar(10),
quantity int,
unit_price decimal(10,2),
total_price decimal(10,2)
); 

